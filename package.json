{
  "name": "bernard-agent",
  "version": "0.9.0",
  "description": "Local CLI AI agent with multi-provider support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bernard": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-builtins.mjs",
    "dev": "BERNARD_DEBUG=1 tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\" \"docs/**/*.{html,css,md}\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md}\" \"docs/**/*.{html,css,md}\" \"*.md\"",
    "refresh-catalog": "tsx scripts/refresh-catalog-fallback.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phillt/bernard.git"
  },
  "bugs": {
    "url": "https://github.com/phillt/bernard/issues"
  },
  "homepage": "https://phillt.github.io/bernard/",
  "author": "phillt",
  "license": "MIT",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "llm",
    "anthropic",
    "openai",
    "xai",
    "terminal",
    "mcp",
    "ai-sdk"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES",
    ".env.example"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.0",
    "@ai-sdk/mcp": "^1.0.19",
    "@ai-sdk/openai": "^1.1.0",
    "@ai-sdk/xai": "^1.1.0",
    "@xenova/transformers": "^2.17.0",
    "ai": "^4.1.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "ink": "^5.0.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "node-cron": "^4.2.1",
    "node-html-parser": "^6.1.0",
    "node-notifier": "^10.0.1",
    "react": "^18.3.1",
    "remend": "^1.3.0",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.2",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.3.12",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^1.6.1"
  }
}
